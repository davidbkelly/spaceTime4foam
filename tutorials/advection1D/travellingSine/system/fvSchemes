FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Space-time CCFV schemes. The problem is steady in space-time.
// CC-2 (default here):  div(phiST,u) Gauss linearUpwind grad(u);
//                       grad(u) Gauss linear
// CC-2-LS:              as CC-2 with grad(u) leastSquares
// CC-1:                 div(phiST,u) Gauss upwind
// CC-2-EX:              as CC-2 with spaceTimeLinearExtrapolation on the
//                       outflow patches (see 0/u)

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default         Gauss linear;
    grad(u)         Gauss linear;
}

divSchemes
{
    default         none;
    div(phiST,u)    Gauss linearUpwind grad(u);
}

laplacianSchemes
{
    default         none;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

