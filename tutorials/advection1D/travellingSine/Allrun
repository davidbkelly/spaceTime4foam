# Script
#     Allrun
#
# Description
#     STUB: the full refinement sweep (all four schemes on the structured and
#     perturbed meshes) is added in stage S5. For now it runs the case as
#     set up (CCFV, CC-2) end to end on one mesh: create the mesh, solve with
#     spaceTime4Foam and compute the errors with spaceTimeErrors
#     (postProcessing/spaceTimeErrors/errors.dat).
#
#     Usage: ./Allrun [N] [left|right] [perturbed [seed]]
#            (default N = 8, left diagonals, not perturbed; see Allmesh)
#
#------------------------------------------------------------------------------
cd "${0%/*}" || exit  # Run from this directory

# Source tutorial run functions
. "${WM_PROJECT_DIR:?}"/bin/tools/RunFunctions

./Allmesh "$@" || exit 1

runApplication "$(getApplication)" || exit 1

# Nominal h = 1/N of the N x N mesh (default N = 8, as in Allmesh)
nominalH=$(awk -v N="${1:-8}" 'BEGIN { printf "%.17g", 1/N }')
runApplication spaceTimeErrors -nominalH "$nominalH" || exit 1

