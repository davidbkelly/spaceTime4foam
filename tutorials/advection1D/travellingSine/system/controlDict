FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// The space-time problem is steady: time counts iterations (deltaT 1), and
// endTime is the maximum number of iterations. spaceTime4Foam writes the
// fields when it converges, or at endTime (and then exits with status 1).

// Load the spaceTimeAnalyticalFixedValue boundary condition in utilities
// such as foamToVTK. Without it they fall back to a generic patch field,
// which needs a value entry (0/u has none).
libs            (spaceTime4FoamModels);

application     spaceTime4Foam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1000;

deltaT          1;

// No intermediate writes
writeControl    timeStep;

writeInterval   100000;

purgeWrite      0;

writeFormat     ascii;

// Full precision: the points (gmshToFoam) and the solution
writePrecision  17;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

// ************************************************************************* //
