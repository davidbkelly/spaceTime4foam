# Script
#     Allclean
#
# Description
#     Remove the generated mesh, logs and the run directory of the sweep
#     (not results/, which holds the committed tables and figures).
#
#------------------------------------------------------------------------------
cd "${0%/*}" || exit  # Run from this directory

# Source tutorial clean functions
. "${WM_PROJECT_DIR:?}"/bin/tools/CleanFunctions

# cleanCase also removes constant/polyMesh (the mesh from gmshToFoam)
cleanCase

# Other files generated by Allmesh
rm -f spaceTimeSquare.msh

# Run directory of the benchmark sweep (Allrun). The results directory is
# kept: it holds the committed tables and figures
rm -rf run

# Remove constant/ only if it is left empty
if [ -d constant ] && [ -z "$(ls -A constant)" ]
then
    rmdir constant
fi

