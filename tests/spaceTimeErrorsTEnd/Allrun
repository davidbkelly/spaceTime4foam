# Script
#     tests/spaceTimeErrorsTEnd/Allrun
#
# Description
#     Known-answer test of the cellCentred t = T columns 21-23 of
#     spaceTimeErrors (L1, L2 and Linf on tEnd of the written boundary
#     values of u, weighted by the face length).
#
#     Mesh: the Left N = 8 tutorial mesh with the points moved by
#     x -> x (1 + x)/2, so that the tEnd faces have different lengths
#     (from 9/128 to 23/128) and a wrong face weight changes the norms.
#     Runs travellingSine with
#       CC-2     zeroGradient on tEnd and xRight (no value entry is written:
#                the written value is the cell value u_P)
#       CC-2-EX  spaceTimeLinearExtrapolation on tEnd and xRight
#                (cornerFallback on)
#     and computes the expected norms here, with awk, from the mesh files
#     (points, faces, owner, boundary) and the written u file only:
#       - face length = max x - min x of the face points (tEnd faces lie on
#         t = 1), face centre x = (max x + min x)/2;
#       - written value = the value entry of tEnd, or u of the owner cell
#         if there is none;
#       - e = value - sin(2 pi (x_f - 1)), L1 = sum |e| L / sum L,
#         L2 = sqrt(sum e^2 L / sum L), Linf = max |e|.
#     Checks (errors.dat has 10 significant digits):
#       - errors.dat has 24 columns;
#       - columns 21-23 equal the expected norms to a relative 1e-8;
#       - CC-2: columns 21-23 equal the cell-value columns 18-20 exactly;
#       - CC-2-EX: the corner-fallback face (the tEnd face of the cell that
#         also has an xRight face) has the written value u_P exactly, and
#         at least one other tEnd face differs from u_P by more than 1e-3
#         (so the EX case is not zeroGradient in disguise).
#     Exits with a non-zero status if a run or a check fails.
#
#------------------------------------------------------------------------------
cd "${0%/*}" || exit  # Run from this directory

# Source tutorial run functions (also sets DYLD_LIBRARY_PATH on Darwin)
. "${WM_PROJECT_DIR:?}"/bin/tools/RunFunctions

for app in spaceTime4Foam spaceTimeErrors
do
    if ! command -v "$app" > /dev/null 2>&1
    then
        echo "$app not found: run ./Allwmake first"
        exit 1
    fi
done

tutorialDir=../../tutorials/advection1D/travellingSine
meshDir=run/mesh

nFailed=0

# check <description> <1 for pass> <details>
function check()
{
    if [ "$2" = "1" ]
    then
        echo "    PASS: $1 ($3)"
    else
        echo "    FAIL: $1 ($3)"
        nFailed=$((nFailed + 1))
    fi
}

# tEndFaces <case directory>
# Print, for every tEnd face in order: face index in the patch, length,
# centre x, owner cell, 1 if the owner also has an xRight face (else 0)
function tEndFaces()
{
    local mesh="$1/constant/polyMesh"
    awk '
        # List entries of an OpenFOAM ascii list file: the size line, then
        # "(", then the entries
        FNR == 1 { file++; state = 0; n = 0 }
        file == 1 {
            # boundary: startFace and nFaces of tEnd and xRight
            if ($1 == "tEnd" || $1 == "xRight") { patch = $1 }
            if (patch != "" && $1 == "nFaces") { nF[patch] = $2 + 0 }
            if (patch != "" && $1 == "startFace") { sF[patch] = $2 + 0 }
            if ($1 == "}") { patch = "" }
            next
        }
        state == 0 && /^[0-9]+$/ { size = $1; state = 1; next }
        state == 1 && /^\($/ { state = 2; next }
        state == 2 && n < size {
            line = $0
            if (file == 2)
            {
                # points: (x y z)
                gsub(/[()]/, "", line); split(line, c, " ")
                px[n] = c[1] + 0
            }
            else if (file == 3)
            {
                # faces: k(a b c ...)
                sub(/^[0-9]+\(/, "", line); sub(/\)$/, "", line)
                fp[n] = line
            }
            else
            {
                # owner
                own[n] = line + 0
            }
            n++
        }
        END {
            for (i = 0; i < nF["xRight"]; i++)
            {
                rightCell[own[sF["xRight"] + i]] = 1
            }
            for (i = 0; i < nF["tEnd"]; i++)
            {
                f = sF["tEnd"] + i
                k = split(fp[f], v, " ")
                lo = px[v[1]]; hi = px[v[1]]
                for (j = 2; j <= k; j++)
                {
                    if (px[v[j]] < lo) { lo = px[v[j]] }
                    if (px[v[j]] > hi) { hi = px[v[j]] }
                }
                printf "%d %.17g %.17g %d %d\n", i, hi - lo, (hi + lo)/2, \
                    own[f], (own[f] in rightCell) ? 1 : 0
            }
        }
    ' "$mesh"/boundary "$mesh"/points "$mesh"/faces "$mesh"/owner
}

# writtenValues <u file> <number of tEnd faces>
# Print the tEnd value entry, one value per line (nothing if none)
function writtenValues()
{
    awk -v n="$2" '
        $1 == "tEnd" { inPatch = 1 }
        inPatch && $1 == "}" { exit }
        inPatch && $1 == "value" {
            line = $0
            sub(/.*List<scalar> *[0-9]*\(/, "", line)
            sub(/\);.*/, "", line)
            k = split(line, v, " ")
            if (k != n) { print "BAD"; exit }
            for (i = 1; i <= k; i++) { print v[i] }
        }
    ' "$1"
}

# cellValues <u file>: the internal field, one value per line
function cellValues()
{
    awk '
        /^internalField/ { state = 1; next }
        state == 1 && /^[0-9]+$/ { size = $1; state = 2; next }
        state == 2 && /^\($/ { state = 3; next }
        state == 3 && n < size { print; n++ }
    ' "$1"
}


# Mesh: Left N = 8, then x -> x (1 + x)/2

rm -rf run
mkdir -p "$meshDir"
cp -r "$tutorialDir"/system "$tutorialDir"/gmsh "$tutorialDir"/Allmesh \
    "$meshDir"/
if ! "$meshDir"/Allmesh 8 left > "$meshDir"/log.Allmesh 2>&1
then
    echo "FAIL: Allmesh (see $meshDir/log.Allmesh)"
    exit 1
fi
awk '
    state == 0 && /^[0-9]+$/ { size = $1; state = 1; print; next }
    state == 1 && /^\($/ { state = 2; print; next }
    state == 2 && n < size {
        line = $0
        gsub(/[()]/, "", line); split(line, c, " ")
        x = c[1] + 0
        printf "(%.17g %s %s)\n", 0.5*x*(1 + x), c[2], c[3]
        n++
        next
    }
    { print }
' "$meshDir"/constant/polyMesh/points > "$meshDir"/points.stretched
mv "$meshDir"/points.stretched "$meshDir"/constant/polyMesh/points
(
    cd "$meshDir" || exit 1
    runApplication -o checkMesh > /dev/null
)
check "checkMesh on the stretched mesh" \
    "$(grep -c '^Mesh OK.' "$meshDir"/log.checkMesh)" "Mesh OK"

for scheme in CC-2 CC-2-EX
do
    echo "$scheme"
    caseDir="run/$scheme"
    mkdir -p "$caseDir"
    cp -r "$tutorialDir"/0 "$tutorialDir"/constant "$tutorialDir"/system \
        "$caseDir"/
    cp -r "$meshDir"/constant/polyMesh "$caseDir"/constant/

    outflow=zeroGradient
    [ "$scheme" = CC-2-EX ] && outflow=spaceTimeLinearExtrapolation
    (
        cd "$caseDir" || exit 1
        for patch in tEnd xRight
        do
            foamDictionary 0/u -entry "boundaryField/$patch/type" \
                -set "$outflow" > /dev/null 2>&1 || exit 1
        done
        runApplication spaceTime4Foam || exit 1
        runApplication spaceTimeErrors -nominalH 0.125 || exit 1
    )
    status=$?
    converged=$(grep -v '^#' "$caseDir"/postProcessing/spaceTimeSolverInfo.dat \
        2> /dev/null | awk '{print $2}')
    if [[ $status -ne 0 ]] || [ "$converged" != "1" ]
    then
        echo "    FAIL: run (exit status $status, converged '$converged';" \
            "see $caseDir)"
        nFailed=$((nFailed + 1))
        continue
    fi

    uFile="$caseDir/$(foamListTimes -case "$caseDir" -latestTime \
        2> /dev/null | tail -1)/u"
    errors=$(grep -v '^#' "$caseDir"/postProcessing/spaceTimeErrors/errors.dat)

    check "errors.dat has 24 columns" \
        "$(echo "$errors" | awk '{print (NF == 24)}')" \
        "$(echo "$errors" | awk '{print NF}') columns"

    tEndFaces "$caseDir" > "$caseDir"/tEndFaces
    nFaces=$(wc -l < "$caseDir"/tEndFaces | tr -d ' ')
    cellValues "$uFile" > "$caseDir"/cellValues
    writtenValues "$uFile" "$nFaces" > "$caseDir"/writtenValues

    if grep -q BAD "$caseDir"/writtenValues
    then
        check "tEnd value entry has one value per face" 0 "$uFile"
        continue
    fi

    # face index, length, centre x, owner, corner flag, u_P, written value
    awk '
        FILENAME == ARGV[1] { cell[FNR - 1] = $1; next }
        FILENAME == ARGV[2] { written[FNR - 1] = $1; nWritten++; next }
        {
            value = (nWritten > 0) ? written[$1] : cell[$4]
            print $0, cell[$4], value
        }
    ' "$caseDir"/cellValues "$caseDir"/writtenValues "$caseDir"/tEndFaces \
        > "$caseDir"/tEndData

    if [ "$scheme" = CC-2 ]
    then
        check "no tEnd value entry (zeroGradient)" \
            "$([ -s "$caseDir"/writtenValues ] && echo 0 || echo 1)" \
            "$(wc -l < "$caseDir"/writtenValues | tr -d ' ') values"
    else
        check "tEnd value entry with one value per face" \
            "$([ "$(wc -l < "$caseDir"/writtenValues | tr -d ' ')" \
                = "$nFaces" ] && echo 1 || echo 0)" "$nFaces faces"
    fi

    # Face lengths differ (the weights matter)
    check "tEnd face lengths differ" \
        "$(awk 'NR == 1 { lo = $2; hi = $2 }
            { if ($2 < lo) lo = $2; if ($2 > hi) hi = $2 }
            END { print (hi > 2*lo) ? 1 : 0 }' "$caseDir"/tEndData)" \
        "$(awk 'NR == 1 { lo = $2; hi = $2 }
            { if ($2 < lo) lo = $2; if ($2 > hi) hi = $2 }
            END { printf "%.6g to %.6g", lo, hi }' "$caseDir"/tEndData)"

    expected=$(awk '
        BEGIN { pi = atan2(0, -1) }
        {
            e = $7 - sin(2*pi*($3 - 1))
            a = (e < 0) ? -e : e
            s1 += a*$2; s2 += e*e*$2; w += $2
            if (a > m) { m = a }
        }
        END { printf "%.10g %.10g %.10g\n", s1/w, sqrt(s2/w), m }
    ' "$caseDir"/tEndData)
    got=$(echo "$errors" | awk '{print $21, $22, $23}')
    check "columns 21-23 equal the expected norms (relative 1e-8)" \
        "$(echo "$expected $got" | awk '{
            ok = 1
            for (i = 1; i <= 3; i++)
            {
                d = $i - $(i + 3); if (d < 0) { d = -d }
                if (d > 1e-8*$i) { ok = 0 }
            }
            print ok
        }')" "expected $expected, got $got"

    if [ "$scheme" = CC-2 ]
    then
        cellCols=$(echo "$errors" | awk '{print $18, $19, $20}')
        check "columns 21-23 equal the cell-value columns 18-20" \
            "$([ "$got" = "$cellCols" ] && echo 1 || echo 0)" "$cellCols"
    else
        corner=$(awk '$5 == 1' "$caseDir"/tEndData)
        check "one corner-fallback tEnd face" \
            "$(echo "$corner" | grep -c .)" \
            "$(echo "$corner" | awk '{print "face", $1, "cell", $4}')"
        check "corner-fallback face: written value equals u_P exactly" \
            "$(echo "$corner" | awk '{print ($6 == $7) ? 1 : 0}')" \
            "$(echo "$corner" | awk '{print "u_P", $6, "written", $7}')"
        check "another tEnd face differs from u_P by more than 1e-3" \
            "$(awk '$5 == 0 { d = $7 - $6; if (d < 0) d = -d;
                if (d > m) m = d } END { print (m > 1e-3) ? 1 : 0 }' \
                "$caseDir"/tEndData)" \
            "$(awk '$5 == 0 { d = $7 - $6; if (d < 0) d = -d;
                if (d > m) m = d } END { printf "max %.3g", m }' \
                "$caseDir"/tEndData)"
    fi
done

echo
if [[ $nFailed -gt 0 ]]
then
    echo "spaceTimeErrorsTEnd: $nFailed check(s) FAILED"
    exit 1
fi

echo "spaceTimeErrorsTEnd: all checks passed"

#------------------------------------------------------------------------------
