FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      spaceTimeProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

spaceTimeModel       cellCentred;

a                    1;

convergenceTolerance 1e-10;

analyticalSolution
{
    type             travellingSine;
    k                1;
}

