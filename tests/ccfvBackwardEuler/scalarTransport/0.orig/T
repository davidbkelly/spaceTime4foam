FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // Inflow value at time t: u(0, t - dt/2) = sin(2 pi (0 - (t - dt/2)))
    //   = -sin(2 pi (t - 0.05)) with dt = 0.1.
    // The Function1 sine is  amplitude*sin(2 pi frequency (t - t0))*scale
    //   + level. See tests/ccfvBackwardEuler/Allrun for why the value is
    // taken at t - dt/2.
    inlet
    {
        type            uniformFixedValue;
        uniformValue
        {
            type            sine;
            amplitude       -1;
            frequency       1;
            t0              0.05;
            scale           1;
            level           0;
        }
    }

    outlet
    {
        type            zeroGradient;
    }

    sides
    {
        type            empty;
    }
}

