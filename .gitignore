# spaceTime4foam .gitignore
# Lines that start with '#' are comments.

# Reference papers are kept locally only (see refs/README.md)
refs/*.pdf

# A hidden file created by the Mac OS X Finder
.DS_Store

# Build and test log files - anywhere
log.*

# Library Make/files are links to Make/files.openfoam or
# Make/files.foamextend, created by Allwmake
src/spaceTime4FoamModels/Make/files

# lnInclude (symlink) folders - anywhere
lnInclude

# build folders - anywhere
linux*Gcc*/
linux*Icc*/
linux*Clang*/
darwin*Gcc*/
darwin*Intel*/
darwin*Arm*/
darwin*Clang*/
linuxming*/

# objects and archives - anywhere
*.[oa]
*.la
*.so
*.dylib

# dependency files - anywhere
*.dep

# Generated case output in tutorials and tests
# - meshes generated by gmsh and imported by gmshToFoam
*.msh
tutorials/**/constant/polyMesh/
tests/**/constant/polyMesh/
# - time (iteration) directories other than 0
tutorials/**/[1-9]*/
tutorials/**/0.[0-9]*/
tests/**/[1-9]*/
tests/**/0.[0-9]*/
# - other run-generated output
processor*/
postProcessing/
VTK/
*.foam
*.OpenFOAM

# editor and misc backup files - anywhere
*~
.*~
*.bak
*.orig
*.rej
\#*\#

# Compilation database and clangd cache
compile_commands.json
.cache/

# end-of-file
