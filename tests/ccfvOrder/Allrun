#
# Script
#     tests/ccfvOrder/Allrun
#
# Description
#     CCFV observed orders on the structured gmsh triangle meshes with left
#     diagonals (direction (1, -1), the benchmark family of CLAUDE.md
#     section 6),
#     N = 8, 16, 32, 64 and 128, for the schemes
#       CC-1     div(phiST,u) Gauss upwind
#       CC-2     div(phiST,u) Gauss linearUpwind grad(u), grad(u) Gauss linear
#       CC-2-LS  as CC-2 with grad(u) leastSquares
#       CC-2-EX  as CC-2 with spaceTimeLinearExtrapolation instead of
#                zeroGradient on the outflow patches tEnd and xRight
#     using the travellingSine tutorial case.
#
#     CC-2-LS-EX (CC-2-LS with spaceTimeLinearExtrapolation) is not run:
#     the corner face values do not converge (see
#     tests/spaceTimeLinearExtrapolation/Allrun).
#
#     REPORT ONLY: the orders are not checked against any window (CLAUDE.md
#     section 6). The test fails only if a run fails: spaceTime4Foam does
#     not converge or exits with an error, or spaceTimeErrors does not
#     write its data line.
#
#     Output (in run/):
#       ccfvOrder.dat        errors, iterations and wall time of every run
#       ccfvOrderOrders.dat  observed orders between successive meshes,
#                            p = log(e_coarse/e_fine)/log(h_coarse/h_fine)
#
#------------------------------------------------------------------------------
cd "${0%/*}" || exit  # Run from this directory

# Source tutorial run functions (also sets DYLD_LIBRARY_PATH on Darwin)
. "${WM_PROJECT_DIR:?}"/bin/tools/RunFunctions

tutorialDir=../../tutorials/advection1D/travellingSine
meshSizes="8 16 32 64 128"
schemes="CC-1 CC-2 CC-2-LS CC-2-EX"

# divScheme <scheme>, gradScheme <scheme>: the fvSchemes entries
function divScheme()
{
    case "$1" in
    CC-1) echo "Gauss upwind" ;;
    *) echo "Gauss linearUpwind grad(u)" ;;
    esac
}

function gradScheme()
{
    case "$1" in
    CC-2-LS) echo "leastSquares" ;;
    *) echo "Gauss linear" ;;
    esac
}

# outflowType <scheme>: the boundary condition type on tEnd and xRight
function outflowType()
{
    case "$1" in
    *-EX) echo "spaceTimeLinearExtrapolation" ;;
    *) echo "zeroGradient" ;;
    esac
}

rm -rf run
mkdir run

resultFile=run/ccfvOrder.dat
orderFile=run/ccfvOrderOrders.dat

norms="L1_all L2_all Linf_all L1_int L2_int Linf_int L1_bnd L2_bnd Linf_bnd"
norms="$norms L1_TExtrap L2_TExtrap Linf_TExtrap L1_TCell L2_TCell Linf_TCell"

{
    echo "# CCFV errors on the structured left-diagonal triangle meshes"
    echo "# (tests/ccfvOrder)"
    echo "# int = interior cells, bnd = boundary cells (a face on a"
    echo "# non-empty patch), TExtrap/TCell = t = T error on tEnd with the"
    echo "# extrapolated face value / the cell value"
    echo "# scheme N h nUnknowns nIter converged finalResidual wallTime[s]" \
        "$norms"
} > "$resultFile"

nFailed=0
failedRuns=""

for N in $meshSizes
do
    # Mesh once per N; all schemes use the same mesh
    meshDir="run/mesh_N$N"
    mkdir -p "$meshDir"
    cp -r "$tutorialDir"/gmsh "$tutorialDir"/system "$tutorialDir"/Allmesh \
        "$meshDir"/
    if ! "$meshDir"/Allmesh "$N" left > "$meshDir"/log.Allmesh 2>&1
    then
        echo "FAIL: Allmesh $N (see $meshDir/log.Allmesh)"
        exit 1
    fi

    for scheme in $schemes
    do
        caseDir="run/${scheme}_N$N"
        mkdir -p "$caseDir"
        cp -r "$tutorialDir"/0 "$tutorialDir"/constant "$tutorialDir"/system \
            "$caseDir"/
        cp -r "$meshDir"/constant/polyMesh "$caseDir"/constant/

        echo "Running $scheme on N = $N"
        (
            cd "$caseDir" || exit 1
            foamDictionary system/fvSchemes -entry "divSchemes/div(phiST,u)" \
                -set "$(divScheme "$scheme")" > /dev/null 2>&1 || exit 1
            foamDictionary system/fvSchemes -entry "gradSchemes/grad(u)" \
                -set "$(gradScheme "$scheme")" > /dev/null 2>&1 || exit 1
            for patch in tEnd xRight
            do
                foamDictionary 0/u -entry "boundaryField/$patch/type" \
                    -set "$(outflowType "$scheme")" > /dev/null 2>&1 \
                    || exit 1
            done
            runApplication spaceTime4Foam || exit 1
            runApplication spaceTimeErrors || exit 1
        )
        status=$?

        infoFile="$caseDir/postProcessing/spaceTimeSolverInfo.dat"
        errorFile="$caseDir/postProcessing/spaceTimeErrors/errors.dat"

        info=""
        if [ -f "$infoFile" ]
        then
            info=$(grep -v '^#' "$infoFile" | tail -1)
        fi
        errors=""
        if [ -f "$errorFile" ]
        then
            errors=$(grep -v '^#' "$errorFile" | tail -1)
        fi

        converged=$(echo "$info" | awk '{print $2}')
        nColumns=$(echo "$errors" | awk '{print NF}')

        if [[ $status -ne 0 ]] || [ "$converged" != "1" ] \
            || [ "$nColumns" != "20" ]
        then
            echo "    FAIL: $scheme N = $N (exit status $status," \
                "converged '$converged', $nColumns error columns)"
            nFailed=$((nFailed + 1))
            failedRuns="$failedRuns ${scheme}_N$N"
            continue
        fi

        # scheme N h nUnknowns, info (4 columns), norms (columns 6-20)
        echo "$scheme $N $info $errors" | awk '{
            printf "%s %s %s %s %s %s %s %s", $1, $2, $8, $9, $3, $4, $5, $6
            for (i = 12; i <= 26; i++) { printf " %s", $i }
            printf "\n"
        }' >> "$resultFile"
    done
done

# Observed orders between successive meshes of the same scheme
awk -v norms="$norms" '
    BEGIN {
        split(norms, name, " ")
        printf "# Observed orders p = log(e_coarse/e_fine)/log(h_coarse/h_fine)\n"
        printf "# (nan if an error is below 1e-12, i.e. zero to round-off)\n"
        printf "# scheme N_coarse N_fine"
        for (k = 1; k <= 15; k++) { printf " p_%s", name[k] }
        printf "\n"
    }
    /^#/ { next }
    {
        # Lines are ordered by N, then scheme: compare with the previous
        # (coarser) mesh of the same scheme
        scheme = $1
        if (scheme in lastN)
        {
            line = scheme " " lastN[scheme] " " $2
            for (k = 1; k <= 15; k++)
            {
                ec = last[scheme, k]; ef = $(8 + k)
                if (ec > 1e-12 && ef > 1e-12)
                {
                    p = log(ec/ef)/log(lastH[scheme]/$3)
                    line = line " " sprintf("%.3f", p)
                }
                else
                {
                    line = line " nan"
                }
            }
            lines[scheme] = lines[scheme] line "\n"
        }
        else
        {
            order[++nSchemes] = scheme
        }
        lastN[scheme] = $2; lastH[scheme] = $3
        for (k = 1; k <= 15; k++) { last[scheme, k] = $(8 + k) }
    }
    END {
        for (s = 1; s <= nSchemes; s++) { printf "%s", lines[order[s]] }
    }
' "$resultFile" > "$orderFile"

echo
echo "Errors ($resultFile):"
grep "^#" "$resultFile"
grep -v "^#" "$resultFile" | column -t
echo
echo "Observed orders ($orderFile):"
grep "^#" "$orderFile"
grep -v "^#" "$orderFile" | column -t
echo

if [[ $nFailed -gt 0 ]]
then
    echo "ccfvOrder: $nFailed run(s) FAILED:$failedRuns"
    exit 1
fi

echo "ccfvOrder: all runs converged (orders are report-only)"

#------------------------------------------------------------------------------
