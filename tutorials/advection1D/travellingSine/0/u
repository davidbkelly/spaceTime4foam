FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      u;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // Inflow (A . n < 0): analytical data. tStart holds the initial data.
    tStart
    {
        type            spaceTimeAnalyticalFixedValue;
    }

    xLeft
    {
        type            spaceTimeAnalyticalFixedValue;
    }

    // Outflow (A . n > 0): no data. zeroGradient (primary) sets u_f = u_P.
    // For the CC-2-EX and CC-2-LS-EX variants (linear extrapolation with
    // grad(u) of system/fvSchemes), use on tEnd and xRight instead:
    //     type            spaceTimeLinearExtrapolation;
    // Keep cornerFallback on (the default): the corner cell with two such
    // faces uses u_f = u_P. With it off, a gradient scheme that is not
    // Gauss-type is a fatal error (leastSquares: unstable corner mode) and
    // Gauss linear gives a non-unique solution.
    tEnd
    {
        type            zeroGradient;
    }

    xRight
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

