FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// One linear solve per space-time iteration. The matrix of div(phiST,u) is
// nonsymmetric. The solver tolerance is well below convergenceTolerance in
// constant/spaceTimeProperties, so that convergence is limited by the
// deferred correction and not by the linear solver.

solvers
{
    u
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-14;
        relTol          0;
        maxIter         1000;
    }
}

// Compute grad(u) once per iteration and reuse it wherever it is requested
// with the same field state (spaceTimeLinearExtrapolation patches and the
// linearUpwind correction). This does not change the results.
cache
{
    grad(u);
}

