FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      spaceTimeProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Space-time discretisation: cellCentred (vertexCentred in a later stage)
spaceTimeModel       cellCentred;

// Advection speed: space-time velocity A = (a, 1, 0), mesh x = x, mesh y = t
a                    1;

// Converged when the initial residual of u falls below this value
convergenceTolerance 1e-10;

// Exact solution, used for the inflow data and the error norms
analyticalSolution
{
    type             travellingSine;    // u = sin(2 pi k (x - a t))
    k                1;
}

