# spaceTime4foam .gitignore
# Lines that start with '#' are comments.

# Reference papers are kept locally only (see refs/README.md)
refs/*.pdf

# A hidden file created by the Mac OS X Finder
.DS_Store

# Build and test log files - anywhere
log.*

# Library Make/files are links to Make/files.openfoam or
# Make/files.foamextend, created by Allwmake
src/spaceTime4FoamModels/Make/files

# lnInclude (symlink) folders - anywhere
lnInclude

# build folders - anywhere
linux*Gcc*/
linux*Icc*/
linux*Clang*/
darwin*Gcc*/
darwin*Intel*/
darwin*Arm*/
darwin*Clang*/
linuxming*/

# objects and archives - anywhere
*.[oa]
*.la
*.so
*.dylib

# dependency files - anywhere
*.dep

# Generated case output in tutorials and tests
# - meshes generated by gmsh and imported by gmshToFoam
*.msh
# - except the hand-written single-prism mesh of this test
!tests/medianDualRightTriangle/rightTriangle.msh
tutorials/**/constant/polyMesh/
tests/**/constant/polyMesh/
# - time (iteration) directories other than 0. Only names made of digits
#   (up to 7), or decimals such as 0.5 and 1e-05, are matched, so that
#   case or test directories such as 2Dfoo are not ignored
tutorials/**/[1-9]/
tutorials/**/[1-9][0-9]/
tutorials/**/[1-9][0-9][0-9]/
tutorials/**/[1-9][0-9][0-9][0-9]/
tutorials/**/[1-9][0-9][0-9][0-9][0-9]/
tutorials/**/[1-9][0-9][0-9][0-9][0-9][0-9]/
tutorials/**/[1-9][0-9][0-9][0-9][0-9][0-9][0-9]/
tutorials/**/[0-9].[0-9]*/
tutorials/**/[1-9][0-9].[0-9]*/
tutorials/**/[0-9]e-[0-9]*/
tests/**/[1-9]/
tests/**/[1-9][0-9]/
tests/**/[1-9][0-9][0-9]/
tests/**/[1-9][0-9][0-9][0-9]/
tests/**/[1-9][0-9][0-9][0-9][0-9]/
tests/**/[1-9][0-9][0-9][0-9][0-9][0-9]/
tests/**/[1-9][0-9][0-9][0-9][0-9][0-9][0-9]/
tests/**/[0-9].[0-9]*/
tests/**/[1-9][0-9].[0-9]*/
tests/**/[0-9]e-[0-9]*/
# - scratch run directories created by the test scripts
tests/*/run/
# - other run-generated output
processor*/
postProcessing/
VTK/
*.foam

# editor and misc backup files - anywhere
*~
.*~
*.bak
*.rej
\#*\#

# Compilation database and clangd cache
compile_commands.json
.cache/

# end-of-file
