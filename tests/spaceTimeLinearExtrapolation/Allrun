#
# Script
#     tests/spaceTimeLinearExtrapolation/Allrun
#
# Description
#     Test of the spaceTimeLinearExtrapolation outflow boundary condition.
#     Runs the travellingSine tutorial case on the N = 16 left-diagonal
#     triangle mesh with tEnd and xRight set to spaceTimeLinearExtrapolation
#     (cornerFallback on, the default), for
#       CC-2-EX     div(phiST,u) Gauss linearUpwind grad(u),
#                   grad(u) Gauss linear
#       CC-2-LS-EX  as CC-2-EX with grad(u) leastSquares
#     and checks:
#       - the solver log reports exactly 2 corner-fallback faces (the tEnd
#         and xRight faces of the top-right corner cell);
#       - Test-spaceTimeLinearExtrapolation on the converged solution: on
#         every outflow face the face value equals
#         u_P + grad(u)_P & (C_f - C_P), except on the 2 fallback faces,
#         where it equals u_P, and it differs from u_P on other faces (see
#         the Test-spaceTimeLinearExtrapolation description for the checks
#         and tolerances).
#     Then checks the guard with cornerFallback off (one iteration each, from
#     the converged CC-2-EX case):
#       - leastSquares, fourth and cellLimited leastSquares 1 (not Gauss-type):
#         spaceTime4Foam must stop with a fatal error;
#       - Gauss linear and cellLimited Gauss linear 1 (Gauss-type):
#         spaceTime4Foam must print the neutral-mode warning.
#     Exits with a non-zero status if a run fails or any check fails.
#
#------------------------------------------------------------------------------
cd "${0%/*}" || exit  # Run from this directory

# Source tutorial run functions (also sets DYLD_LIBRARY_PATH on Darwin)
. "${WM_PROJECT_DIR:?}"/bin/tools/RunFunctions

if ! command -v Test-spaceTimeLinearExtrapolation > /dev/null 2>&1
then
    echo "Test-spaceTimeLinearExtrapolation not found: run ./Allwmake first"
    exit 1
fi

N=16
tutorialDir=../../tutorials/advection1D/travellingSine
schemes="CC-2-EX CC-2-LS-EX"

# gradScheme <scheme>: the grad(u) entry of fvSchemes
function gradScheme()
{
    case "$1" in
    CC-2-LS-EX) echo "leastSquares" ;;
    *) echo "Gauss linear" ;;
    esac
}

rm -rf run
mkdir run

# Mesh once; all schemes use the same mesh
meshDir=run/mesh
mkdir -p "$meshDir"
cp -r "$tutorialDir"/gmsh "$tutorialDir"/system "$tutorialDir"/Allmesh \
    "$meshDir"/
if ! "$meshDir"/Allmesh "$N" left > "$meshDir"/log.Allmesh 2>&1
then
    echo "FAIL: Allmesh $N (see $meshDir/log.Allmesh)"
    exit 1
fi

nFailed=0
failedRuns=""

for scheme in $schemes
do
    caseDir="run/$scheme"
    mkdir -p "$caseDir"
    cp -r "$tutorialDir"/0 "$tutorialDir"/constant "$tutorialDir"/system \
        "$caseDir"/
    cp -r "$meshDir"/constant/polyMesh "$caseDir"/constant/

    echo "Running $scheme on N = $N"
    (
        cd "$caseDir" || exit 1
        foamDictionary system/fvSchemes -entry "divSchemes/div(phiST,u)" \
            -set "Gauss linearUpwind grad(u)" > /dev/null 2>&1 || exit 1
        foamDictionary system/fvSchemes -entry "gradSchemes/grad(u)" \
            -set "$(gradScheme "$scheme")" > /dev/null 2>&1 || exit 1
        for patch in tEnd xRight
        do
            foamDictionary 0/u -entry "boundaryField/$patch/type" \
                -set spaceTimeLinearExtrapolation > /dev/null 2>&1 || exit 1
        done
        runApplication spaceTime4Foam || exit 1
        runApplication Test-spaceTimeLinearExtrapolation -fallbackFaces 2 \
            || exit 1
    )
    status=$?

    # Number of corner-fallback faces reported by the solver (all patches)
    nFallback=$(grep "faces use the corner fallback" \
        "$caseDir"/log.spaceTime4Foam 2>/dev/null \
        | awk '{n += $4} END {print n + 0}')
    if [ "$nFallback" = "2" ]
    then
        echo "    PASS: solver log: $nFallback corner-fallback faces"
    else
        echo "    FAIL: solver log: '$nFallback' corner-fallback faces," \
            "expected 2"
        status=1
    fi

    logFile="$caseDir/log.Test-spaceTimeLinearExtrapolation"
    if [ -f "$logFile" ]
    then
        sed -n '/^Patch/,$p' "$logFile"
    fi

    if [[ $status -ne 0 ]]
    then
        echo "    FAIL: $scheme (exit status $status, see $caseDir)"
        nFailed=$((nFailed + 1))
        failedRuns="$failedRuns $scheme"
    fi
done

# Guard with cornerFallback off: one iteration from a copy of the converged
# CC-2-EX case for each gradient scheme below. Gauss-type schemes (the
# allow-list of the boundary condition) must give the neutral-mode warning;
# all other schemes must stop with a fatal error.
guardNames=(LS fourth cellLimitedLS Gauss cellLimitedGauss)
guardSchemes=(
    "leastSquares"
    "fourth"
    "cellLimited leastSquares 1"
    "Gauss linear"
    "cellLimited Gauss linear 1"
)
guardExpected=(fatal fatal fatal warning warning)

for i in "${!guardNames[@]}"
do
    name="${guardNames[$i]}"
    guardScheme="${guardSchemes[$i]}"
    caseDir="run/noFallback-$name"
    rm -rf "$caseDir"
    mkdir -p "$caseDir"
    cp -r run/CC-2-EX/0 run/CC-2-EX/constant run/CC-2-EX/system "$caseDir"/
    (
        cd "$caseDir" || exit 1
        foamDictionary system/fvSchemes -entry "gradSchemes/grad(u)" \
            -set "$guardScheme" > /dev/null 2>&1 || exit 1
        for patch in tEnd xRight
        do
            foamDictionary 0/u -entry "boundaryField/$patch/cornerFallback" \
                -add off > /dev/null 2>&1 || exit 1
        done
        foamDictionary system/controlDict -entry endTime -set 1 \
            > /dev/null 2>&1 || exit 1
        spaceTime4Foam > log.spaceTime4Foam 2>&1
    )
    status=$?

    logFile="$caseDir/log.spaceTime4Foam"
    case "${guardExpected[$i]}" in
    fatal)
        if [[ $status -ne 0 ]] && grep -q "FOAM FATAL ERROR" "$logFile" \
            && grep -q "is not a Gauss-type gradient scheme" "$logFile"
        then
            echo "    PASS: '$guardScheme' without fallback stops with a" \
                "fatal error"
        else
            echo "    FAIL: '$guardScheme' without fallback: exit status" \
                "$status, no fatal error (see $logFile)"
            nFailed=$((nFailed + 1))
            failedRuns="$failedRuns noFallback-$name"
        fi
        ;;
    *)
        # One iteration does not converge, so the exit status is not used
        if grep -q "neutral mode" "$logFile" \
            && ! grep -q "FOAM FATAL" "$logFile"
        then
            echo "    PASS: '$guardScheme' without fallback prints the" \
                "warning"
        else
            echo "    FAIL: '$guardScheme' without fallback: exit status" \
                "$status, no warning or a fatal error (see $logFile)"
            nFailed=$((nFailed + 1))
            failedRuns="$failedRuns noFallback-$name"
        fi
        ;;
    esac
done

if [[ $nFailed -gt 0 ]]
then
    echo "spaceTimeLinearExtrapolation: $nFailed case(s) FAILED:$failedRuns"
    exit 1
fi

echo "spaceTimeLinearExtrapolation: all checks passed"

#------------------------------------------------------------------------------
