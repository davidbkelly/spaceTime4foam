#!/bin/bash
# Print the matched-unknown L2 ratios used by spaceTime4foamGuide.md.
# The source is the interpolated accuracy table made by the tutorial's
# makeTables script, not a fit or an extrapolation.
cd "${0%/*}/.." || exit 1

awk '
    !/^#/ && $3 == "L2_all" &&
    (($1 == "leftStructured" &&
        ($2 == "CC-2-EX" || $2 == "VC-2")) ||
     ($1 == "leftPerturbed" &&
        ($2 == "CC-2-LS" || $2 == "VC-2"))) {
        for (i = 4; i <= 8; i++) { e[$1, $2, i] = $i }
    }
    END {
        split("1000 3000 10000 30000 60000", n, " ")
        print "unknowns structured_CC-2-EX_over_VC-2" \
            " perturbed_CC-2-LS_over_VC-2"
        for (i = 4; i <= 8; i++) {
            if (!( ("leftStructured" SUBSEP "CC-2-EX" SUBSEP i) in e) ||
                !( ("leftStructured" SUBSEP "VC-2" SUBSEP i) in e) ||
                !( ("leftPerturbed" SUBSEP "CC-2-LS" SUBSEP i) in e) ||
                !( ("leftPerturbed" SUBSEP "VC-2" SUBSEP i) in e)) {
                print "guideRatios: a required summary row is missing" > "/dev/stderr"
                exit 1
            }
            structured = e["leftStructured", "CC-2-EX", i] / \
                e["leftStructured", "VC-2", i]
            perturbed = e["leftPerturbed", "CC-2-LS", i] / \
                e["leftPerturbed", "VC-2", i]
            printf "%d %.2f %.2f\n", n[i - 3], structured, perturbed
        }
    }
' tutorials/advection1D/travellingSine/results/summary.dat
