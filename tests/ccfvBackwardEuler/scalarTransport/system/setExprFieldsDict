FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Initial data u(x, 0) = sin(2 pi x) at the cell centres

expressions
(
    T
    {
        field       T;
        dimensions  [0 0 0 0 0 0 0];

        expression
        #{
            sin(2*pi()*pos().x())
        #};
    }
);

