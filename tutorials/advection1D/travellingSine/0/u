FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      u;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // Inflow (A . n < 0): analytical data. tStart holds the initial data.
    tStart
    {
        type            spaceTimeAnalyticalFixedValue;
    }

    xLeft
    {
        type            spaceTimeAnalyticalFixedValue;
    }

    // Outflow (A . n > 0): no data
    tEnd
    {
        type            zeroGradient;
    }

    xRight
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

